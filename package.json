    "quasar": "^2.35.2",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@quasar/app-vite": "^3.10.3",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.12.0",
