  "schemas": {
    "AddContractParticipantRequest": {
      "required": [
        "clientId",
        "allocatedAmount"
      ],
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "format": "uuid",
          "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        },
        "allocatedAmount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": [
            "null",
            "number",
            "string"
          ],
          "format": "double",
          "example": 1000.0
        }
      },
      "additionalProperties": false
    },
    "ContractAssetUniverseSummaryResponse": {
      "required": [
        "assetCount",
        "marketCount",
        "currencyCount",
        "networkCount"
      ],
      "type": "object",
      "properties": {
        "assetCount": {
          "pattern": "^-?(?:0|[1-9]\\d*)$",
          "type": [
            "integer",
            "string"
          ],
          "format": "int32"
        },
        "marketCount": {
          "pattern": "^-?(?:0|[1-9]\\d*)$",
          "type": [
            "integer",
            "string"
          ],
          "format": "int32"
        },
        "currencyCount": {
          "pattern": "^-?(?:0|[1-9]\\d*)$",
          "type": [
            "integer",
            "string"
          ],
          "format": "int32"
        },
        "networkCount": {
          "pattern": "^-?(?:0|[1-9]\\d*)$",
          "type": [
            "integer",
            "string"
          ],
          "format": "int32"
        }
      }
    },
    "ContractListItemResponse": {
      "required": [
        "id",
        "publicCode",
        "name",
        "registrationStatus",
        "businessStatus",
        "createdAtUtc",
        "clients",
        "clientCount",
        "initialContractualCapital",
        "currentCapital",
        "currencyCode",
        "startDate",
        "endDate",
        "primaryEngine",
        "assetUniverseSummary"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        },
        "publicCode": {
          "type": "string"
        },
        "name": {
          "type": [
            "null",
            "string"
          ],
          "example": "Jane Doe"
        },
        "registrationStatus": {
          "type": "string"
        },
        "businessStatus": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/ContractReferenceResponse"
            }
          ]
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time",
          "example": "2026-11-18T00:00:00Z"
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ContractListClientResponse"
          }
        },
        "clientCount": {
          "pattern": "^-?(?:0|[1-9]\\d*)$",
          "type": [
            "integer",
            "string"
          ],
          "format": "int32"
        },
        "initialContractualCapital": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": [
            "null",
            "number",
            "string"
          ],
          "format": "double"
        },
        "currentCapital": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": [
            "null",
            "number",
            "string"
          ],
          "format": "double"
        },
        "currencyCode": {
          "type": [
            "null",
            "string"
          ],
          "example": "EUR"
        },
        "startDate": {
          "type": [
            "null",
            "string"
          ],
          "format": "date",
          "example": "2026-11-18"
        },
        "endDate": {
          "type": [
            "null",
            "string"
          ],
          "format": "date",
          "example": "2026-11-18"
        },
        "primaryEngine": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/ContractListEngineResponse"
            }
          ]
        },
        "assetUniverseSummary": {
          "$ref": "#/components/schemas/ContractAssetUniverseSummaryResponse"
        }
      }
    }
  },
  "findings": [
    "currentCapital is nullable; listing keeps unavailable rather than copying initialContractualCapital.",
    "Contract listing has no intraday count/result summary. No contract-request or intraday route in current OpenAPI; contract-operations handles financial contract operations and is not an intraday trade recording contract.",
    "POST participant already exists; selected participant entry still has the documented item 138 source-wallet/write blockers. No participant created in this revalidation."
  ]
