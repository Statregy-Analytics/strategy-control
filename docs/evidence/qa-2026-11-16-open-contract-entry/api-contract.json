          "string"
        ],
        "format": "double"
      },
      "entryValue": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double"
      },
      "engineConfigurationVersionId": {
        "type": [
          "null",
          "string"
        ],
        "format": "uuid",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "engineSnapshotId": {
        "type": [
          "null",
          "string"
        ],
        "format": "uuid",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
