  "ContractResponse": {
    "required": [
      "id",
      "publicCode",
      "name",
      "registrationStatus",
      "term",
      "startDate",
      "expectedEndDate",
      "currency",
      "initialContractualCapital",
      "initialConsolidatedCapital",
      "currentBalance",
      "initialCapitalOrigin",
      "financialNotes",
      "businessStatus",
      "primaryEngine",
      "participants",
      "createdAtUtc",
      "updatedAtUtc",
      "finalizedAtUtc",
      "version",
      "assetUniverseSummary"
    ],
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "publicCode": {
        "type": "string"
      },
      "name": {
        "type": [
          "null",
          "string"
        ],
        "example": "Jane Doe"
      },
      "registrationStatus": {
        "type": "string"
      },
      "term": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/ContractTermResponse"
          }
        ]
      },
      "startDate": {
        "type": [
          "null",
          "string"
        ],
        "format": "date",
        "example": "2026-11-16"
      },
      "expectedEndDate": {
        "type": [
          "null",
          "string"
        ],
        "format": "date",
        "example": "2026-11-16"
      },
      "currency": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/ContractCurrencyResponse"
          }
        ]
      },
      "initialContractualCapital": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double"
      },
      "initialConsolidatedCapital": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double"
      },
      "currentBalance": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double",
        "example": 1000.0
      },
      "initialCapitalOrigin": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/ContractReferenceResponse"
          }
        ]
      },
      "financialNotes": {
        "type": [
          "null",
          "string"
        ],
        "example": "Example description."
      },
      "businessStatus": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/ContractReferenceResponse"
          }
        ]
      },
      "primaryEngine": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/ContractPrimaryEngineResponse"
          }
        ]
      },
      "participants": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ContractParticipantResponse"
        }
      },
      "createdAtUtc": {
        "type": "string",
        "format": "date-time",
        "example": "2026-11-16T00:00:00Z"
      },
      "updatedAtUtc": {
        "type": [
          "null",
          "string"
        ],
        "format": "date-time",
        "example": "2026-11-16T00:00:00Z"
      },
      "finalizedAtUtc": {
        "type": [
          "null",
          "string"
        ],
        "format": "date-time",
        "example": "2026-11-16T00:00:00Z"
      },
      "version": {
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "type": [
          "integer",
          "string"
        ],
        "format": "int32"
      },
      "assetUniverseSummary": {
        "$ref": "#/components/schemas/ContractAssetUniverseSummaryResponse"
      }
    }
  }
}