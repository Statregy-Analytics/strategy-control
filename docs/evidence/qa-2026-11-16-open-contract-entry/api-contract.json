{
  "AddContractParticipantRequest": {
    "required": [
      "clientId",
      "allocatedAmount"
    ],
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "format": "uuid",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "allocatedAmount": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double",
        "example": 1000.0
      }
    },
    "additionalProperties": false
  },
  "ContractParticipantResponse": {
    "required": [
      "participantId",
      "clientId",
      "displayName",
      "personType",
      "allocatedAmount",
      "allocationPercentage",
      "contributedAmount",
      "baseAmount",
      "linkedAtUtc"
    ],
    "type": "object",
    "properties": {
