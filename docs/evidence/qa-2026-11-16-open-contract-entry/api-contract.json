      "clientId": {
        "type": "string",
        "format": "uuid",
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "displayName": {
        "type": "string",
        "example": "Jane Doe"
      },
      "personType": {
        "type": "string"
      },
      "allocatedAmount": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double",
        "example": 1000.0
      },
      "allocationPercentage": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double"
      },
      "contributedAmount": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "number",
          "string"
        ],
        "format": "double",
        "example": 1000.0
      },
      "baseAmount": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": [
          "null",
          "number",
          "string"
        ],
        "format": "double",
        "example": 1000.0
      },
      "linkedAtUtc": {
        "type": "string",
        "format": "date-time",
        "example": "2026-11-16T00:00:00Z"
      }
    }
